# Copy to backend/.env on your VM before running setup-vm.sh
HOST=0.0.0.0
PORT=8080

# Comma-separated frontend origins (local + Vercel production URL)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-app.vercel.app

# Optional: allow all Vercel preview deployments (default regex below)
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

CACHE_TTL_SECONDS=300
MIN_RISK_REWARD=1.5

# vader = lightweight (Vercel). finbert = ProsusAI/finbert (VM/local only).
SENTIMENT_BACKEND=finbert
