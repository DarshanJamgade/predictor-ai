# Optional: HTTPS reverse proxy for the API (recommended for production).
# 1. Point api.yourdomain.com A record to your VM public IP
# 2. sudo cp deploy/nginx-api.conf.example /etc/nginx/sites-available/predictor-api
# 3. Edit server_name and paths, then:
#    sudo ln -s /etc/nginx/sites-available/predictor-api /etc/nginx/sites-enabled/
#    sudo nginx -t && sudo systemctl reload nginx
# 4. sudo apt install certbot python3-certbot-nginx
#    sudo certbot --nginx -d api.yourdomain.com

server {
    listen 80;
    server_name api.yourdomain.com;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Stock analysis can take 30–90s on cold start
        proxy_connect_timeout 120s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
    }
}
